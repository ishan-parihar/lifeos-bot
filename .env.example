# LifeOS Bot — Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Telegram Bot Configuration (REQUIRED)
# ============================================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ============================================
# Notion API Configuration (REQUIRED)
# ============================================
# Get API key from https://www.notion.com/my-integrations
NOTION_API_KEY=your_notion_api_key_here

# Notion Database IDs (discover automatically after first run:
#   python -m lifeos direct notion-discovery  OR  see CLI_PLAN.md)
DATABASE_ID_ACTIVITY_LOG=placeholder_activity_log
DATABASE_ID_FINANCIAL_LOG=placeholder_financial_log
DATABASE_ID_DIET_LOG=placeholder_diet_log
DATABASE_ID_SUBJECTIVE_JOURNAL=placeholder_subjective_journal
DATABASE_ID_RELATIONAL_JOURNAL=placeholder_relational_journal
DATABASE_ID_SYSTEMIC_JOURNAL=placeholder_systemic_journal
